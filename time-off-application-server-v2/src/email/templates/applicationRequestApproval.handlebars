<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  {{> styles}}
</head>

<body>
  <p>Dear {{approver.firstName}},</p>
  <p>
    Action:
    <a href="{{renderActionEmailMailTo 'approved' newApplication}}">Approve</a>
    /
    <a href="{{renderActionEmailMailTo 'rejected' newApplication}}">Reject</a>
  </p>
  <p>I am sending this request for your approval of a time off application. </p>
  <p>Please find the application as follow:</p>
  {{> application newAppl=newApplication oldAppl=oldApplication}}
</body>

</html>